# Copy to .env (the Windows launcher does this for you on first run).

# Leave empty to run the deterministic rules adjudicator only.
ANTHROPIC_API_KEY=
# auto = Claude if a key is set, else rules | rules | claude
STC_ADJUDICATOR=auto
STC_MODEL=claude-sonnet-5

# Watchlist source:
#   opensanctions                 -> OFAC SDN + UN SC + EU FSF + UK FCDO via OpenSanctions (downloaded, cached, refreshed)
#   opensanctions:us_ofac_sdn     -> any comma-separated OpenSanctions dataset names
#   sample                        -> bundled fictional list (tests / offline demo)
#   data/ofac                     -> folder with OFAC SDN.CSV/ALT.CSV/ADD.CSV (see `stc load-ofac`)
STC_WATCHLIST=opensanctions
# Hours between OpenSanctions update checks (0 = only at startup)
STC_REFRESH_HOURS=6
STC_THRESHOLD=85
STC_DB_PATH=stc.sqlite3
STC_CUSTOMERS=data/customers/customers.csv
# Allow the "Reset queue" demo button
STC_ALLOW_RESET=true
